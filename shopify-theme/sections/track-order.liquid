{%- comment -%}
  Track order page.
  [INTEGRATION] Production: query the Order API via an app proxy (order number
  + email must both match) or embed your 3PL/carrier tracking widget (AfterShip,
  Parcelpanel, 17TRACK). The demo below explains exactly where data will come
  from and never fabricates an order status.
{%- endcomment -%}
<div class="container page-head" style="padding-bottom:0">
  <p class="eyebrow">Order tracking</p>
  <h1 class="h-display" style="font-size:clamp(30px,4vw,44px)">Track your order</h1>
  <p class="lede mt-3">Enter your order number and the email used at checkout — or a tracking number — to see live status.</p>
</div>

<section class="section section--tight">
  <div class="container" style="max-width:640px">
    <form class="checkout-box" data-track-form>
      <div class="form-grid">
        <div class="field field--full">
          <label for="trackNum">Order number or tracking number</label>
          <input id="trackNum" required placeholder="e.g. #1234 or 1Z999AA1…" autocomplete="off">
        </div>
        <div class="field field--full">
          <label for="trackEmail">Email used at checkout</label>
          <input id="trackEmail" type="email" required placeholder="you@example.com" autocomplete="email">
        </div>
      </div>
      <button class="btn btn--primary btn--full mt-5" type="submit">Track order</button>
      <p class="small muted mt-4">Lost your order number? Email <a href="mailto:{{ settings.support_email }}">{{ settings.support_email }}</a> and we'll find it.</p>
    </form>
    <div class="mt-6" data-track-result aria-live="polite"></div>
  </div>
</section>

<script>
  document.addEventListener('submit', function (e) {
    var form = e.target.closest('[data-track-form]');
    if (!form) return;
    e.preventDefault();
    var num = document.getElementById('trackNum').value.trim();
    var email = document.getElementById('trackEmail').value.trim();
    if (!num || !email) return;
    document.querySelector('[data-track-result]').innerHTML =
      '<div class="demo-banner"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M12 11v5"/></svg>' +
      '<span><strong>Not connected yet.</strong> “' + num.replace(/[<>&]/g, '') + '” can’t be looked up until our order system is linked. At launch this page queries the order API (order number + email must match) or your tracking provider and shows live carrier status.</span></div>' +
      '<div class="checkout-box"><h3><span class="step-num">✓</span> How tracking will work</h3>' +
      '<div class="mt-4">' +
      ['Order placed', 'Preparing for dispatch', 'In transit', 'Delivered'].map(function (s) {
        return '<div class="assurance__row" style="border-bottom:1px solid var(--line-soft)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" style="color:var(--ink-faint)"><circle cx="12" cy="12" r="9"/></svg><div><strong>' + s + '</strong></div></div>';
      }).join('') + '</div></div>';
    HN.analytics && HN.analytics.track('track_order_search', {});
  });
</script>

{% schema %}
{ "name": "Track order", "settings": [] }
{% endschema %}
