<section class="section" aria-label="Lifestyle">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="title">{{ section.settings.heading }}</h2>
    </div>
    <div class="editorial">
      {%- for block in section.blocks -%}
        <figure class="editorial__item{% if forloop.first or forloop.last %} editorial__item--wide{% endif %}" data-reveal style="--reveal-delay:{{ forloop.index0 | times: 8 }}ms" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: block.settings.caption, widths: '600,900,1200,1600' }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lifestyle editorial",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In real homes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for the rooms you actually live in" }
  ],
  "blocks": [
    {
      "type": "scene",
      "name": "Scene",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "presets": [{
    "name": "Lifestyle editorial",
    "blocks": [
      { "type": "scene", "settings": { "caption": "The living room, after sunset" } },
      { "type": "scene", "settings": { "caption": "Bedside warmth" } },
      { "type": "scene", "settings": { "caption": "Dinner, properly lit" } },
      { "type": "scene", "settings": { "caption": "The patio, open late" } }
    ]
  }]
}
{% endschema %}
