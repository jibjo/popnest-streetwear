<section class="section" aria-label="Journal">
  <div class="container">
    <div class="section-head section-head--row" data-reveal>
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="title">{{ section.settings.heading }}</h2>
      </div>
      <a class="link-arrow" href="{{ blogs[section.settings.blog].url | default: blogs.journal.url | default: blogs.news.url }}">All articles
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
    <div class="post-grid">
      {%- assign blog = blogs[section.settings.blog] | default: blogs.journal | default: blogs.news -%}
      {%- for article in blog.articles limit: 3 -%}
        <a class="post-card" href="{{ article.url }}" data-reveal style="--reveal-delay:{{ forloop.index0 | times: 8 }}ms">
          <div class="post-card__media">
            {%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: article.title, widths: '400,600,900' }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
          </div>
          <div class="post-card__body">
            <span class="post-card__tag">{{ article.published_at | date: '%b %Y' }}</span>
            <h3 class="post-card__title">{{ article.title }}</h3>
            <p class="post-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 110 }}</p>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ideas worth switching on" },
    { "type": "blog", "id": "blog", "label": "Blog" }
  ],
  "presets": [{ "name": "Blog posts" }]
}
{% endschema %}
