<section class="section" aria-labelledby="fc-{{ section.id }}">
  <div class="container">
    <div class="section-head section-head--row" data-reveal>
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="title" id="fc-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="link-arrow" href="{{ section.settings.link }}">{{ section.settings.link_label }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}
    </div>
    <div class="product-grid">
      {%- assign col = collections[section.settings.collection] -%}
      {%- for product in col.products limit: section.settings.count -%}
        {%- render 'product-card', product: product, index: forloop.index -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="card">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Designed to be noticed. Built to be lived in." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all products" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
