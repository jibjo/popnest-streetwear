<section class="section section--surface" aria-label="{{ section.settings.heading | escape }}">
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="title">{{ section.settings.heading }}</h2>
    </div>
    <div class="trust-grid">
      {%- for block in section.blocks -%}
        <div class="trust-card" data-reveal style="--reveal-delay:{{ forloop.index0 | times: 6 }}ms" {{ block.shopify_attributes }}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 13l4 4L19 7"/></svg>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.body }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust bar",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why shop Heavenly" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Store you can trust, service you can reach" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Secure checkout" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Encrypted with HTTPS/TLS. Payments are processed by our payment provider — card details never touch our servers." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "item", "settings": { "title": "Secure checkout", "body": "Encrypted with HTTPS/TLS. Payments are processed by our payment provider — card details never touch our servers." } },
      { "type": "item", "settings": { "title": "Order tracking", "body": "Follow every order from our hands to your door with email updates and live tracking." } },
      { "type": "item", "settings": { "title": "Reachable support", "body": "Real humans, replying within one business day — before and after your purchase." } },
      { "type": "item", "settings": { "title": "Clear returns", "body": "Our policy states exactly what's eligible, for how long, and how fast refunds are processed." } },
      { "type": "item", "settings": { "title": "Transparent shipping", "body": "Costs and delivery windows estimated before checkout and confirmed at checkout." } },
      { "type": "item", "settings": { "title": "Quality you can verify", "body": "Full materials, dimensions and electrical specs on every product page — plus a 2-year warranty on lighting." } }
    ]
  },
  "presets": [{ "name": "Trust bar" }]
}
{% endschema %}
