<div class="container page-head" style="padding-bottom:0">
  <p class="eyebrow">{{ section.settings.eyebrow }}</p>
  <h1 class="h-display" style="font-size:clamp(30px,4vw,44px)">{{ section.settings.heading }}</h1>
  <p class="lede mt-3">{{ section.settings.body }}</p>
</div>

<section class="section section--tight">
  <div class="container shop-layout" style="grid-template-columns:1.15fr .85fr">
    <div class="checkout-box">
      <h3>Send a message</h3>
      {% form 'contact' %}
        {%- if form.posted_successfully? -%}
          <div class="ship-est-result" style="background:#e7f3ec;color:var(--success)">✓ Thanks — your message is with our team. We reply within one business day.</div>
        {%- else -%}
          {%- if form.errors -%}<p style="color:var(--danger)">Please check the highlighted fields.</p>{%- endif -%}
          <div class="form-grid">
            <div class="field"><label for="cf-name">Your name</label><input id="cf-name" name="contact[name]" required autocomplete="name" value="{{ form.name }}"></div>
            <div class="field"><label for="cf-email">Email</label><input id="cf-email" type="email" name="contact[email]" required autocomplete="email" value="{{ form.email }}"></div>
            <div class="field field--full"><label for="cf-topic">Topic</label>
              <select id="cf-topic" name="contact[topic]">
                <option>Order question</option><option>Product &amp; specifications</option>
                <option>Shipping help</option><option>Returns help</option>
                <option>Trade / bulk enquiry</option><option>Something else</option>
              </select>
            </div>
            <div class="field field--full"><label for="cf-body">Message</label><textarea id="cf-body" name="contact[body]" rows="6" required>{{ form.body }}</textarea></div>
          </div>
          <button class="btn btn--primary mt-5" type="submit">Send message</button>
        {%- endif -%}
      {% endform %}
    </div>
    <aside style="display:grid;gap:16px;align-content:start">
      <div class="checkout-box">
        <h3>Direct</h3>
        <div class="assurance__row" style="border:0;padding:8px 0">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
          <div><strong>Email</strong><span><a href="mailto:{{ settings.support_email }}">{{ settings.support_email }}</a></span></div>
        </div>
        <div class="assurance__row" style="border:0;padding:8px 0">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
          <div><strong>Support hours</strong><span>{{ settings.business_hours }}</span></div>
        </div>
      </div>
      <div class="checkout-box">
        <h3>Quick answers</h3>
        <div class="footer__links" style="color:var(--ink)">
          <a href="{{ routes.root_url }}pages/track-order" class="link-arrow">Track an order</a>
          <a href="{{ routes.root_url }}policies/shipping-policy" class="link-arrow">Shipping help</a>
          <a href="{{ routes.root_url }}policies/refund-policy" class="link-arrow">Returns help</a>
          <a href="{{ routes.root_url }}pages/faq" class="link-arrow">Full FAQ</a>
        </div>
      </div>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "We're here to help" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Real humans, one-business-day replies. No scripts, no runaround." }
  ]
}
{% endschema %}
