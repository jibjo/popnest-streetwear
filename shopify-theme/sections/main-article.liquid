<article class="section section--tight">
  <div class="container article">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span class="sep">/</span><a href="{{ blog.url }}">{{ blog.title }}</a><span class="sep">/</span><span>{{ article.title }}</span></nav>
    <div class="article__meta"><span class="post-card__tag">{{ article.published_at | date: '%b %-d, %Y' }}</span><span>·</span><span>{{ article.author }}</span></div>
    <h1 class="h-display" style="font-size:clamp(30px,4.4vw,48px)">{{ article.title }}</h1>
    {%- if article.image -%}
      <div class="article__hero">{{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', alt: article.title, widths: '600,900,1200,1600' }}</div>
    {%- endif -%}
    <div class="article">{{ article.content }}</div>
  </div>
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ article.title | json }},
  {% if article.image %}"image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}
  "datePublished": {{ article.published_at | date: '%Y-%m-%d' | json }},
  "author": { "@type": "Organization", "name": {{ shop.name | json }} }
}
</script>

{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
