{%- comment -%} FAQ accordion — FAQPage structured data included {%- endcomment -%}
<div class="accordion" id="faq-{{ section.id }}">
  {%- for block in section.blocks -%}
    <div class="accordion__item" {{ block.shopify_attributes }}>
      <h2><button class="accordion__trigger" aria-expanded="false" aria-controls="faq-{{ section.id }}-{{ forloop.index }}">{{ block.settings.question }}
        <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></button></h2>
      <div class="accordion__content" id="faq-{{ section.id }}-{{ forloop.index }}"><div class="accordion__content-inner">{{ block.settings.answer }}</div></div>
    </div>
  {%- endfor -%}
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>

{% schema %}
{
  "name": "FAQ accordion",
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does shipping take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Orders are prepared in [PROCESSING TIME], then typically 3–7 business days domestically. Live estimates appear at checkout.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ accordion", "blocks": [ { "type": "qa" }, { "type": "qa" }, { "type": "qa" } ] }]
}
{% endschema %}
