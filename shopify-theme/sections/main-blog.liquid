<div class="container page-head" style="padding-bottom:0">
  <p class="eyebrow">{{ section.settings.eyebrow }}</p>
  <h1 class="h-display" style="font-size:clamp(32px,5vw,52px)">{{ blog.title }}</h1>
  <p class="lede mt-3">{{ section.settings.tagline }}</p>
</div>

<section class="section section--tight">
  <div class="container post-grid">
    {%- paginate blog.articles by 12 -%}
      {%- for article in blog.articles -%}
        <a class="post-card" href="{{ article.url }}" data-reveal>
          <div class="post-card__media">
            {%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: article.title, widths: '400,600,900' }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
          </div>
          <div class="post-card__body">
            <span class="post-card__tag">{{ article.published_at | date: '%b %-d, %Y' }}</span>
            <h2 class="post-card__title">{{ article.title }}</h2>
            <p class="post-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
          </div>
        </a>
      {%- endfor -%}
      {%- if paginate.pages > 1 -%}
        <nav class="w-full mt-6" style="grid-column:1/-1;display:flex;gap:10px;justify-content:center">
          {%- if paginate.previous -%}<a class="btn btn--ghost btn--small" href="{{ paginate.previous.url }}">← Newer</a>{%- endif -%}
          {%- if paginate.next -%}<a class="btn btn--ghost btn--small" href="{{ paginate.next.url }}">Older →</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Heavenly Journal" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Original guides on lighting and styling — written by our team." }
  ]
}
{% endschema %}
