<header class="header" id="siteHeader">
  <div class="container header__inner">
    <button class="icon-btn header__toggle" data-drawer-open="mobileDrawer" aria-label="{{ 'general.menu' | t }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>

    <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} — home">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 500 }}" alt="{{ shop.name }}" width="{{ settings.logo_width }}" height="auto" style="width:{{ settings.logo_width }}px">
      {%- else -%}
        <span class="logo__mark" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="5"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>
        </span>
        <span class="logo__word">{{ settings.brand_wordmark }}<small>{{ settings.brand_tagline }}</small></span>
      {%- endif -%}
    </a>

    <nav class="nav" aria-label="Primary">
      {%- for link in section.settings.menu.links -%}
        {%- if link.links != blank -%}
          <div class="nav__item">
            <a class="nav__link" href="{{ link.url }}" aria-haspopup="true">{{ link.title }}<span class="nav__caret">▾</span></a>
            <div class="dropdown" role="menu">
              {%- for child in link.links -%}
                <a href="{{ child.url }}">{{ child.title }}</a>
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <a class="nav__link{% if link.active %} is-active{% endif %}" href="{{ link.url }}">{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="header__actions">
      {%- if settings.enable_currency_estimates -%}
        <select class="currency-select currency-select--header" id="currencySelect" aria-label="{{ 'general.currency' | t }}">
          <option value="USD" selected>USD $</option><option value="EUR">EUR €</option>
          <option value="GBP">GBP £</option><option value="CAD">CAD $</option>
          <option value="AUD">AUD $</option><option value="AED">AED</option>
          <option value="JPY">JPY ¥</option><option value="INR">INR ₹</option>
        </select>
      {%- endif -%}
      <button class="icon-btn" data-drawer-open="searchDrawer" aria-label="{{ 'general.search' | t }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      </button>
      <a class="icon-btn" href="{{ routes.root_url }}pages/wishlist" data-wishlist-link aria-label="Wishlist">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20s-7-4.6-9.3-8.6C.9 8 2.6 4.5 6 4.5c2.2 0 3.6 1.2 6 3.7 2.4-2.5 3.8-3.7 6-3.7 3.4 0 5.1 3.5 3.3 6.9C19 15.4 12 20 12 20z"/></svg>
        <span class="icon-btn__badge js-wish-count">0</span>
      </a>
      <a class="icon-btn" href="{{ routes.account_url }}" aria-label="Account">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg>
      </a>
      <button class="icon-btn" data-drawer-open="cartDrawer" aria-label="{{ 'cart.title' | t }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 7h12l1 13H5L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
        <span class="icon-btn__badge js-cart-count{% if cart.item_count > 0 %} is-visible{% endif %}">{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>

{%- comment -%} Mobile drawer nav mirrors the main menu {%- endcomment -%}
<div class="drawer" id="mobileDrawer" aria-hidden="true">
  <div class="drawer__scrim" data-drawer-close></div>
  <div class="drawer__panel drawer__panel--left" role="dialog" aria-label="{{ 'general.menu' | t }}">
    <div class="drawer__head">
      <span class="drawer__title">{{ 'general.menu' | t }}</span>
      <button class="icon-btn" data-drawer-close aria-label="{{ 'general.close' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    </div>
    <div class="drawer__body mobile-nav">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }} <span>→</span></a>
        {%- for child in link.links -%}
          <a href="{{ child.url }}" style="padding-left:18px;font-size:15px;color:var(--ink-soft)">{{ child.title }} <span>→</span></a>
        {%- endfor -%}
      {%- endfor -%}
      <div class="mobile-nav__group">Support</div>
      <a href="{{ routes.root_url }}pages/track-order">Track Order <span>→</span></a>
      <a href="{{ routes.root_url }}pages/contact">Contact <span>→</span></a>
    </div>
    <div class="drawer__foot">
      <a class="btn btn--primary btn--full" href="{{ section.settings.featured_collection_url | default: routes.all_products_collection_url }}">Shop the collection</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu",
      "info": "Tip: create a 'main-menu' in Navigation with Shop, Lighting (dropdown), Outdoor, Home Decor, New Arrivals, Best Sellers, About, Contact." },
    { "type": "url", "id": "featured_collection_url", "label": "Mobile CTA link" }
  ]
}
{% endschema %}
