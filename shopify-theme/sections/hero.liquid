<section class="hero" aria-label="{{ section.settings.heading | escape }}">
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt | default: section.settings.heading, sizes: '100vw', widths: '800,1200,1600,2400' }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="container hero__inner">
    <div class="hero__content">
      {%- if section.settings.kicker != blank -%}<p class="hero__kicker" data-hero-fade><span class="dot"></span> {{ section.settings.kicker }}</p>{%- endif -%}
      <h1 class="display" data-hero-fade>{{ section.settings.heading }}</h1>
      <p class="hero__lede" data-hero-fade>{{ section.settings.subheading }}</p>
      <div class="hero__ctas" data-hero-fade>
        {%- if section.settings.cta1_label != blank -%}<a class="btn btn--accent" href="{{ section.settings.cta1_link }}" data-track-cta="hero_primary">{{ section.settings.cta1_label }}</a>{%- endif -%}
        {%- if section.settings.cta2_label != blank -%}<a class="btn btn--ghost-light" href="{{ section.settings.cta2_link }}" data-track-cta="hero_secondary">{{ section.settings.cta2_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "New — the Arden outdoor sconce" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Light Up Your Space With Modern Elegance" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Discover thoughtfully designed lighting and home décor made to transform everyday spaces." },
    { "type": "text", "id": "cta1_label", "label": "Primary CTA", "default": "Shop Outdoor Lighting" },
    { "type": "url", "id": "cta1_link", "label": "Primary CTA link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary CTA", "default": "Explore Best Sellers" },
    { "type": "url", "id": "cta2_link", "label": "Secondary CTA link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
