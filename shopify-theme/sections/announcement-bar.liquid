<div class="announcement" role="region" aria-label="{{ 'general.menu' | t }}">
  <div class="announcement__inner container">
    <div class="announcement__track" aria-live="polite">
      {%- for block in section.blocks -%}
        <p class="announcement__msg{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {{ block.settings.text }}
          {%- if block.settings.link_label != blank and block.settings.link != blank -%}
            <span class="dot">•</span> <a href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on qualifying orders • Secure checkout • Easy returns" },
        { "type": "text", "id": "link_label", "label": "Link label (optional)" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "message" },
      { "type": "message", "settings": { "text": "Thoughtfully designed lighting & décor • Ships worldwide" } }
    ]
  }
}
{% endschema %}
