{%- comment -%}
  HEAVENLY — main product section (OS 2.0).
  Specifications are NOT hard-coded: every row is a "spec" block the store
  owner fills in (or maps from metafields via the named metafield below).
  Reviews support: @app blocks (Judge.me / Loox / Okendo…) + verified
  metafield ratings + clearly-labelled sample mode for development.
{%- endcomment -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}

<div class="container section--tight" style="padding-top:28px">
  {%- render 'structured-data-breadcrumbs', crumbs: 'product' -%}
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a><span class="sep">/</span>
    {%- if collection %}<a href="{{ collection.url }}">{{ collection.title }}</a><span class="sep">/</span>{%- endif -%}
    <span>{{ product.title }}</span>
  </nav>
</div>

<section class="section--tight" aria-label="{{ product.title | escape }}">
  <div class="container pdp" id="pdpRoot" data-product-handle="{{ product.handle }}">
    {%- comment -%} ---------- Gallery ---------- {%- endcomment -%}
    <div class="gallery" id="pdpGallery">
      <div class="gallery__main" id="galMain" role="button" tabindex="0" aria-label="Zoom product image">
        {%- if product.featured_image -%}
          {{ product.featured_image | image_url: width: 1400 | image_tag: id: 'galImg', loading: 'eager', alt: product.featured_image.alt | default: product.title, widths: '600,900,1400', sizes: '(min-width:960px) 50vw, 100vw' }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="gallery__thumbs">
          {%- for image in product.images -%}
            <button class="gallery__thumb{% if forloop.first %} is-active{% endif %}" data-thumb="{{ image | image_url: width: 1400 }}" aria-label="View image {{ forloop.index }}">
              {{ image | image_url: width: 200 | image_tag: loading: 'lazy', alt: image.alt | default: product.title }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
      <p class="gallery__hint">Hover to zoom · click to enlarge</p>
    </div>

    {%- comment -%} ---------- Buy panel (blocks) ---------- {%- endcomment -%}
    <div class="buy-panel">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'vendor' -%}
            <p class="eyebrow" {{ block.shopify_attributes }}>{{ product.vendor }}</p>

          {%- when 'title' -%}
            <h1 {{ block.shopify_attributes }}>{{ product.title }}</h1>

          {%- when 'price' -%}
            <div {{ block.shopify_attributes }} data-price-wrapper>
              <div class="buy-panel__price">
                <span class="price" data-product-price>{% render 'price', product: product, use_variant: true %}</span>
                {%- if product.compare_at_price > product.price -%}
                  <s data-compare-price>{% render 'price', price: product.compare_at_price %}</s>
                  <span class="badge badge--sale">Save {{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}%</span>
                {%- endif -%}
              </div>
              <p class="buy-panel__tax">{{ 'products.product.taxes_included' | t }}</p>
            </div>

          {%- when 'inventory' -%}
            {%- if current_variant.available -%}
              {%- if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity <= section.settings.low_stock_threshold and current_variant.inventory_quantity > 0 -%}
                <p class="stock stock--low" {{ block.shopify_attributes }}><span class="stock__dot"></span>{{ 'products.product.low_stock' | t }}</p>
              {%- else -%}
                <p class="stock" {{ block.shopify_attributes }}><span class="stock__dot"></span>{{ 'products.product.in_stock' | t }}</p>
              {%- endif -%}
            {%- else -%}
              <p class="stock stock--out" {{ block.shopify_attributes }}><span class="stock__dot"></span>{{ 'products.product.sold_out' | t }} — back-in-stock alerts available</p>
            {%- endif -%}

          {%- when 'description' -%}
            <div class="lede mt-4" {{ block.shopify_attributes }}>{{ product.description | split: '<h2' | first }}</div>
            {%- if product.metafields.custom.features != blank -%}
              <ul class="mt-4" style="display:grid;gap:8px;padding-left:20px;color:var(--ink-soft)">
                {%- assign features = product.metafields.custom.features | split: '|' -%}
                {%- for f in features -%}<li>{{ f }}</li>{%- endfor -%}
              </ul>
            {%- endif -%}

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <variant-picker class="option-group" data-url="{{ product.url }}" data-section="{{ section.id }}" {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  <div class="option-group" style="margin-top:20px">
                    <span class="option-group__label">{{ option.name }}</span>
                    <div class="swatches" role="radiogroup" aria-label="{{ option.name | escape }}">
                      {%- for value in option.values -%}
                        <input type="radio" id="opt-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}" name="option-{{ forloop.parentloop.index }}" value="{{ value | escape }}" class="visually-hidden" {% if option.selected_value == value %}checked{% endif %}>
                        <label class="swatch" for="opt-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}">
                          <span class="swatch__dot" style="background:{{ value | downcase | replace: 'black', '#26282b' | replace: 'bronze', '#7d684d' | replace: 'brass', '#b18f5e' | replace: 'white', '#eae6de' | default: '#d8cfc0' }}"></span>{{ value }}
                        </label>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endfor -%}
                <script type="application/json" data-variant-json>{{ product.variants | json }}</script>
              </variant-picker>
            {%- endunless -%}

          {%- when 'quantity' -%}
            <div class="qty-row" {{ block.shopify_attributes }}>
              {%- render 'quantity-selector', name: 'quantity', value: 1 -%}
              <button class="btn btn--primary" data-add-to-cart {% unless current_variant.available %}disabled{% endunless %}>
                <span data-add-to-cart-text>{% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
              </button>
            </div>

          {%- when 'buy_buttons' -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.show_dynamic_checkout -%}
                <div class="buy-panel__ctas">
                  {%- if additional_checkout_buttons -%}
                    <div style="grid-column:1/-1">{{ content_for_additional_checkout_buttons }}</div>
                  {%- endif -%}
                  <a class="btn btn--ghost" href="{{ routes.root_url }}pages/wishlist" data-wishlist-link>{{ 'products.product.view_wishlist' | t }}</a>
                </div>
              {%- endif -%}
              <div class="wish-line">
                <button class="wish-btn" data-wishlist-button data-wishlist-handle="{{ product.handle }}">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 20s-7-4.6-9.3-8.6C.9 8 2.6 4.5 6 4.5c2.2 0 3.6 1.2 6 3.7 2.4-2.5 3.8-3.7 6-3.7 3.4 0 5.1 3.5 3.3 6.9C19 15.4 12 20 12 20z"/></svg>
                  <span data-wishlist-label>{{ 'products.product.wishlist_add' | t }}</span>
                </button>
              </div>
            </div>

          {%- when 'shipping_estimator' -%}
            {%- render 'shipping-estimator' -%}

          {%- when 'assurance' -%}
            <div class="assurance mt-6" {{ block.shopify_attributes }}>
              {%- assign rows = block.settings.rows | newline_to_br | split: '<br />' -%}
              {%- for row in rows -%}
                {%- assign parts = row | split: '|' -%}
                {%- if parts[0] != blank -%}
                  <div class="assurance__row"><span>✓</span><div><strong>{{ parts[0] }}</strong>{% if parts[1] != blank %}<span>{{ parts[1] }}</span>{% endif %}</div></div>
                {%- endif -%}
              {%- endfor -%}
            </div>

          {%- when 'warranty' -%}
            {%- if product.metafields.custom.warranty != blank or block.settings.text != blank -%}
              <div class="assurance__row" style="border:1px solid var(--line);border-radius:14px;margin-top:12px" {{ block.shopify_attributes }}>
                <span>✓</span><div><strong>Warranty</strong><span>{{ product.metafields.custom.warranty | default: block.settings.text }}</span></div>
              </div>
            {%- endif -%}

          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- comment -%} ---------- Tabs: specs / install / shipping ---------- {%- endcomment -%}
<section class="section pdp-details" aria-label="Product details">
  <div class="container">
    <div class="tabs">
      <div class="tabs__nav" role="tablist">
        <button class="is-active">Specifications</button>
        <button>Installation &amp; care</button>
        <button>Shipping &amp; returns</button>
        {%- if section.settings.show_faq -%}<button>FAQ</button>{%- endif -%}
      </div>
      <div>
        {%- comment -%} Specs: admin-entered rows, or metafield fallback {%- endcomment -%}
        <div class="tabs__panel is-active">
          {%- assign meta_specs = product.metafields.custom.specifications -%}
          {%- if section.blocks.size > 0 or meta_specs != blank -%}
            <table class="spec-table">
              {%- for block in section.blocks -%}
                {%- if block.type == 'spec' -%}
                  <tr {{ block.shopify_attributes }}><th scope="row">{{ block.settings.label }}</th><td>{{ block.settings.value }}</td></tr>
                {%- endif -%}
              {%- endfor -%}
              {%- if meta_specs != blank -%}
                {%- assign spec_pairs = meta_specs | newline_to_br | split: '<br />' -%}
                {%- for pair in spec_pairs -%}
                  {%- assign kv = pair | split: '|' -%}
                  <tr><th scope="row">{{ kv[0] }}</th><td>{{ kv[1] }}</td></tr>
                {%- endfor -%}
              {%- endif -%}
            </table>
            {%- if section.settings.specs_note != blank -%}<p class="spec-note">{{ section.settings.specs_note }}</p>{%- endif -%}
          {%- else -%}
            <p class="muted">Specifications are being finalised — contact us and we'll answer any question directly.</p>
          {%- endif -%}
        </div>
        <div class="tabs__panel">
          <div class="prose">{{ pages[section.settings.installation_page].content | default: '<p>Installation and care guidance ships with your product. Questions? Email our team any time.</p>' }}</div>
        </div>
        <div class="tabs__panel">
          <div class="prose">
            <h3>Shipping</h3>
            <p>Orders are prepared in {{ pages['shipping-policy'].metafields.custom.processing_time | default: '[PROCESSING TIME]' }} and ship with tracked carriers. Use the estimator above for an estimate to your country.</p>
            <h3>Returns</h3>
            <p>See our <a class="link-arrow" style="font-size:inherit" href="{{ routes.root_url }}policies/refund-policy">Returns &amp; Refunds policy</a> for eligibility and the current return window. Damaged on arrival? Contact us within 48 hours.</p>
          </div>
        </div>
        {%- if section.settings.show_faq -%}
          <div class="tabs__panel">
            {%- render 'faq-accordion', source: 'product', product: product, id_prefix: 'pdp' -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- comment -%} ---------- Reviews ---------- {%- endcomment -%}
<section class="section section--surface" id="reviews" aria-label="Reviews">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Reviews</p>
      <h2 class="title">What owners say</h2>
    </div>
    {%- render 'reviews-block', product: product -%}
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
    {%- endfor -%}
  </div>
</section>

{%- comment -%} ---------- Frequently bought together (complementary products) ---------- {%- endcomment -%}
{%- assign recs = product.metafields.recommendations.products.value -%}
{%- if recs.count > 0 or section.settings.fbt_collection != blank -%}
  <section class="section section--tight" aria-label="Frequently bought together">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Complete the look</p>
        <h2 class="title" style="font-size:clamp(22px,3vw,30px)">Frequently bought together</h2>
      </div>
      <div class="fbt" data-reveal>
        <div class="fbt__row">
          {%- if recs.count > 0 -%}
            {%- for p in recs limit: 2 -%}
              <label class="fbt__item">
                <input type="checkbox" checked data-fbt-variant-id="{{ p.selected_or_first_available_variant.id }}" data-fbt-price="{{ p.price }}">
                {{ p.featured_image | image_url: width: 220 | image_tag: loading: 'lazy', alt: p.title }}
                <span class="t">{{ p.title }}</span>
                <span class="p">{% render 'price', product: p %}</span>
              </label>
            {%- endfor -%}
          {%- endif -%}
          <div class="fbt__cta">
            <button class="btn btn--primary btn--small" data-fbt-add>Add selected to bag</button>
          </div>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{%- comment -%} ---------- Related products ---------- {%- endcomment -%}
{%- assign related = collections[section.settings.related_collection].products -%}
<section class="section" aria-label="Related products">
  <div class="container">
    <div class="section-head section-head--row" data-reveal>
      <div>
        <p class="eyebrow">You may also like</p>
        <h2 class="title">Related products</h2>
      </div>
      <a class="link-arrow" href="{{ routes.all_products_collection_url }}">Shop all</a>
    </div>
    <div class="product-grid">
      {%- assign shown = 0 -%}
      {%- for p in collections[section.settings.related_collection].products limit: 8 -%}
        {%- unless p.handle == product.handle -%}
          {%- if shown < 4 -%}{%- render 'product-card', product: p -%}{%- assign shown = shown | plus: 1 -%}{%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- render 'structured-data-product', product: product -%}

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "paragraph", "content": "Specs are entered by the store owner as blocks below (or via the product.specifications metafield as 'Label|Value' lines). Never hard-coded." },
    { "type": "checkbox", "id": "show_faq", "label": "Show FAQ tab", "default": true },
    { "type": "textarea", "id": "specs_note", "label": "Specs footnote", "default": "Specifications are confirmed by the store owner and stated before purchase." },
    { "type": "range", "id": "low_stock_threshold", "min": 1, "max": 25, "step": 1, "label": "Low-stock threshold (honest status only — never fake counts)", "default": 5 },
    { "type": "page", "id": "installation_page", "label": "Installation & care page" },
    { "type": "collection", "id": "related_collection", "label": "Related products collection" },
    { "type": "collection", "id": "fbt_collection", "label": "Frequently-bought-together collection" }
  ],
  "blocks": [
    { "type": "vendor", "name": "Vendor", "limit": 1 },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "inventory", "name": "Inventory status", "limit": 1 },
    { "type": "description", "name": "Description", "limit": 1 },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    { "type": "quantity", "name": "Quantity + Add to cart", "limit": 1 },
    { "type": "buy_buttons", "name": "Buy buttons / wishlist", "limit": 1 },
    { "type": "shipping_estimator", "name": "Shipping estimator", "limit": 1 },
    {
      "type": "assurance",
      "name": "Assurance rows",
      "settings": [
        { "type": "textarea", "id": "rows", "label": "Rows — one per line, format: Title|Body", "default": "Shipping estimate|Use the estimator for your country's cost and window.
Easy returns|See the Returns & Refunds policy for the current window.
Secure checkout|256-bit SSL. Payment processed by our provider — card details never touch our servers." }
      ]
    },
    { "type": "warranty", "name": "Warranty", "limit": 1, "settings": [{ "type": "text", "id": "text", "label": "Warranty text", "default": "2-year limited warranty against manufacturing defects." }] },
    {
      "type": "spec",
      "name": "Specification row",
      "settings": [
        { "type": "text", "id": "label", "label": "Label (e.g. Dimensions)" },
        { "type": "text", "id": "value", "label": "Value (exact, from supplier)" }
      ]
    },
    { "type": "@app" }
  ]
}
{% endschema %}
