<section class="section section--night newsletter" id="newsletter" aria-labelledby="nl-{{ section.id }}">
  <div class="newsletter__glow" aria-hidden="true"></div>
  <div class="container newsletter__inner">
    <p class="eyebrow" style="color:var(--accent)" data-reveal>{{ section.settings.eyebrow }}</p>
    <h2 class="title" id="nl-{{ section.id }}" data-reveal>{{ section.settings.heading }}</h2>
    <p class="lede mt-3" style="color:var(--night-ink-soft)" data-reveal>{{ section.settings.body }}</p>

    {% form 'customer', class: 'js-newsletter-wrap' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <div class="newsletter__success is-visible" role="status">✓ You're on the list. Please check your inbox to confirm — we only send email to subscribers who opted in.</div>
      {%- else -%}
        <div class="newsletter-form-row" data-reveal>
          <label class="visually-hidden" for="nl-email-{{ section.id }}">Email address</label>
          <input id="nl-email-{{ section.id }}" type="email" name="contact[email]" placeholder="Your email address" required value="{{ form.email }}">
          <button class="btn btn--accent" type="submit">Subscribe</button>
        </div>
      {%- endif -%}
    {% endform %}

    <p class="newsletter__note">{{ section.settings.privacy_note }} <a href="{{ section.settings.privacy_link | default: '/policies/privacy-policy' }}">Privacy Policy</a>.</p>
  </div>
</section>

<style>
  .newsletter-form-row { display: flex; gap: 10px; margin-top: 24px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.18); padding: 8px; border-radius: 999px; max-width: 520px; margin-inline: auto; }
  .newsletter-form-row input { flex: 1; background: transparent; border: 0; outline: none; color: #fff; padding: 10px 18px; font-size: 15px; min-width: 0; }
  .newsletter-form-row input::placeholder { color: rgba(255,255,255,.55); }
  @media (max-width: 640px) { .newsletter-form-row { flex-direction: column; border-radius: var(--radius); padding: 10px; } .newsletter-form-row .btn { width: 100%; } }
</style>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stay in the light" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bring Better Design Home" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Join the list for early access to new collections, styling guides and subscriber-only offers. Unsubscribe anytime." },
    { "type": "textarea", "id": "privacy_note", "label": "Privacy note", "default": "By subscribing you agree to our" },
    { "type": "url", "id": "privacy_link", "label": "Privacy policy link" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
