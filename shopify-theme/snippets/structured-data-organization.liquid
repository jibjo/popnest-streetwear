<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | append: page.url | json }},
  {%- if settings.logo -%}
  "logo": {{ settings.logo | image_url: width: 512 | prepend: 'https:' | json }},
  {%- endif -%}
  "sameAs": []
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {{ shop.url | append: '/search?q={search_term_string}' | json }},
    "query-input": "required name=search_term_string"
  }
}
</script>
