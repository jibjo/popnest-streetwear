{%- comment -%}
  FAQ accordion snippet — used on product pages (rendered by main-product).
  FAQs come from the product metafield: custom.faqs
  Type: JSON. Format: [{"q":"Question","a":"Answer"}, ...]
  The store owner enters them per product in the admin — never hard-coded.
  Params: product, id_prefix (optional)
{%- endcomment -%}
{%- assign faqs = product.metafields.custom.faqs.value -%}
{%- if faqs != blank -%}
  <div class="accordion" id="faq-{{ id_prefix | default: 'pdp' }}">
    {%- for faq in faqs -%}
      <div class="accordion__item">
        <h3>
          <button class="accordion__trigger" aria-expanded="false" aria-controls="faq-{{ id_prefix | default: 'pdp' }}-{{ forloop.index }}">
            {{ faq.q }}
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </button>
        </h3>
        <div class="accordion__content" id="faq-{{ id_prefix | default: 'pdp' }}-{{ forloop.index }}">
          <div class="accordion__content-inner">{{ faq.a }}</div>
        </div>
      </div>
    {%- endfor -%}
  </div>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for faq in faqs -%}
      {
        "@type": "Question",
        "name": {{ faq.q | json }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ faq.a | strip_html | json }} }
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  </script>
{%- else -%}
  <p class="muted">Questions? Email <a href="mailto:{{ settings.support_email }}">{{ settings.support_email }}</a> — we reply within one business day.</p>
{%- endif -%}
