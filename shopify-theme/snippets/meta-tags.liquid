{%- comment -%} SEO title + description + Open Graph + Twitter {%- endcomment -%}
{%- assign og_title = page_title | default: shop.name -%}
{%- assign og_description = page_description | default: shop.description | default: shop.name -%}
{%- assign og_image = '' -%}
{%- if template.name == 'product' -%}
  {%- assign og_image = product.featured_image | image_url: width: 1200 -%}
{%- elsif template.name == 'article' -%}
  {%- assign og_image = article.image | image_url: width: 1200 -%}
{%- elsif collection.image -%}
  {%- assign og_image = collection.image | image_url: width: 1200 -%}
{%- endif -%}

<title>{{ page_title }}{% if current_tags %} &middot; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &middot; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &middot; {{ shop.name }}{% endunless %}</title>
<meta name="description" content="{{ og_description | escape }}">
{%- if paginate.current_page > 1 -%}<meta name="robots" content="noindex,follow">{%- endif -%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:type" content="{% if template.name == 'product' %}product{% elsif template.name == 'article' %}article{% else %}website{% endif %}">
{%- if og_image != blank -%}
  <meta property="og:image" content="https:{{ og_image }}">
  <meta property="og:image:width" content="1200">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="https:{{ og_image }}">
{%- else -%}
  <meta name="twitter:card" content="summary">
{%- endif -%}
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
