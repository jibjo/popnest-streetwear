<div class="container section" style="max-width:460px">
  <h1 class="h-title">Choose a new password</h1>
  <div class="checkout-box mt-5">
    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="field field--full"><label for="rp-pass">New password</label><input id="rp-pass" type="password" name="customer[password]" required autocomplete="new-password"></div>
      <div class="field field--full"><label for="rp-pass2">Confirm password</label><input id="rp-pass2" type="password" name="customer[password_confirmation]" required autocomplete="new-password"></div>
      <button class="btn btn--primary btn--full mt-4" type="submit">Reset password</button>
    {%- endform -%}
  </div>
</div>
